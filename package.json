{
  "name": "full-stack-store-rating-app",
  "version": "1.0.0",
  "description": "A full-stack web application for store rating system with role-based authentication",
  "main": "server.js",
  "scripts": {
    "dev": "npm run build && npm run server",
    "server": "nodemon backend/server.js",
    "client": "cd frontend && npm start",
    "build": "cd frontend && npm run build",
    "install-all": "npm install && cd frontend && npm install",
    "setup-db": "node backend/scripts/setup-db.js",
    "seed": "node backend/scripts/seed.js",
    "start": "npm run build && node backend/server.js"
  },
  "keywords": [
    "express",
    "react",
    "postgresql",
    "jwt",
    "authentication"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}
